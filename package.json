{
  "name": "fworld",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "setup": "npm ci",
    "dev": "vite",
    "dev:server": "node --env-file-if-exists=.env scripts/dev-server.mjs",
    "build": "npm run check && vite build && npm run build:server",
    "build:server": "vite build --ssr server/main.ts --outDir dist/server --emptyOutDir",
    "start": "node --env-file-if-exists=.env dist/server/main.js",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "tsc --noEmit && npm run typecheck:server && npm run format:check",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "ui:check": "node scripts/ui-check.mjs",
    "eval": "node scripts/upgrade-verify.mjs && node scripts/framework-verify.mjs",
    "doctor": "npm run check && npm test && npm run build"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.87",
    "@ai-sdk/openai-compatible": "3.0.71",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "ai": "7.0.126",
    "idb": "^8.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fake-indexeddb": "^6.2.5",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
